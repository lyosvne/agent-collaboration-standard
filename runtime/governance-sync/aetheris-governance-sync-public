#!/usr/bin/python3 -I
"""Fail-closed fixed-public-source installer for the ECS governance mirror."""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import uuid
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from typing import Iterator, Sequence

MIRROR = Path("/opt/pi/governance-mirror/repo")
LOCK = Path("/run/lock/aetheris-governance-sync.lock")
RECEIPTS = Path("/var/lib/aetheris-governance-sync/receipts")

PUBLIC_REMOTE = "https://github.com/lyosvne/agent-collaboration-standard.git"
PUBLIC_PROTOCOL = "https"
REMOTE_URL_ID = "governance-public-origin-v1"
MASTER_REF = "refs/heads/master"
BACKUP_NAMESPACE = "refs/aetheris-governance-sync/backups"
OPERATION_NAMESPACE = "refs/aetheris-governance-sync/operations"
FETCH_NAMESPACE = "refs/aetheris-governance-sync/fetch"
ZERO_OID = "0" * 40
COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
GIT_TIMEOUT_SECONDS = 120
RECEIPT_VERSION = 1


class SyncError(RuntimeError):
    """Expected, sanitized failure."""

    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code


class JsonArgumentParser(argparse.ArgumentParser):
    """Turn every CLI contract failure into the helper's single JSON error."""

    def error(self, message: str) -> None:
        raise SyncError("invalid_arguments", "command line does not match the contract")


@dataclass(frozen=True)
class Request:
    commit: str
    dry_run: bool


@dataclass(frozen=True)
class MirrorState:
    commit: str
    branch: str
    mirror_identity: tuple[int, int]
    git_identity: tuple[int, int]
    config_identity: tuple[int, int]


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def establish_process_security() -> None:
    os.umask(0o027)
    if os.geteuid() == 0:
        raise SyncError("root_execution_forbidden", "helper must not run as root")


def parse_args(argv: Sequence[str] | None = None) -> Request:
    parser = JsonArgumentParser(
        prog="aetheris-governance-sync-public",
        allow_abbrev=False,
        add_help=False,
        description="Update the fixed governance mirror from its fixed public source.",
    )
    parser.add_argument("--commit", required=True, metavar="40_HEX")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    ns = parser.parse_args(argv)
    if not COMMIT_RE.fullmatch(ns.commit):
        parser.error("--commit must be exactly 40 lowercase hexadecimal characters")
    return Request(commit=ns.commit, dry_run=ns.dry_run)


def git(
    *args: str,
    cwd: Path,
    check: bool = True,
    timeout: int = GIT_TIMEOUT_SECONDS,
) -> subprocess.CompletedProcess[str]:
    """Run a fixed Git executable without ambient credentials or configuration."""
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": "/nonexistent",
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_ASKPASS": "/bin/false",
        "SSH_ASKPASS": "/bin/false",
    }
    fixed_config = (
        "-c",
        "core.hooksPath=/dev/null",
        "-c",
        "init.templateDir=",
        "-c",
        "maintenance.auto=false",
        "-c",
        "credential.helper=",
        "-c",
        "http.extraHeader=",
        "-c",
        "protocol.allow=never",
    )
    try:
        result = subprocess.run(
            ["/usr/bin/git", *fixed_config, *args],
            cwd=cwd,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
            shell=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SyncError("git_execution_failed", "git command could not complete") from exc
    if check and result.returncode != 0:
        raise SyncError("git_validation_failed", "git rejected the repository or operation")
    return result


def _owned_directory(path: Path, *, code: str) -> tuple[Path, os.stat_result]:
    try:
        metadata = path.lstat()
        resolved = path.resolve(strict=True)
        resolved_metadata = resolved.lstat()
    except OSError as exc:
        raise SyncError(code, "required directory is unavailable") from exc
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or metadata.st_mode & 0o022
        or not stat.S_ISDIR(resolved_metadata.st_mode)
        or (metadata.st_dev, metadata.st_ino)
        != (resolved_metadata.st_dev, resolved_metadata.st_ino)
    ):
        raise SyncError(code, "directory ownership, mode, or identity is unsafe")
    return resolved, metadata


def _owned_regular_file(
    path: Path,
    *,
    parent: Path,
    code: str,
) -> os.stat_result:
    try:
        metadata = path.lstat()
        resolved = path.resolve(strict=True)
        resolved.relative_to(parent)
        resolved_metadata = resolved.lstat()
    except (OSError, ValueError) as exc:
        raise SyncError(code, "required file is unavailable or escapes its directory") from exc
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or metadata.st_mode & 0o022
        or not stat.S_ISREG(resolved_metadata.st_mode)
        or (metadata.st_dev, metadata.st_ino)
        != (resolved_metadata.st_dev, resolved_metadata.st_ino)
    ):
        raise SyncError(code, "file ownership, mode, or identity is unsafe")
    return metadata


def validate_mirror() -> MirrorState:
    mirror_real, mirror_metadata = _owned_directory(MIRROR, code="mirror_unsafe")
    git_path = MIRROR / ".git"
    git_real, git_metadata = _owned_directory(git_path, code="mirror_gitdir_invalid")
    try:
        git_real.relative_to(mirror_real)
    except ValueError as exc:
        raise SyncError("mirror_gitdir_escape", "mirror git directory escapes mirror") from exc
    config_metadata = _owned_regular_file(
        git_path / "config",
        parent=git_real,
        code="mirror_config_unsafe",
    )
    if git("rev-parse", "--is-inside-work-tree", cwd=MIRROR).stdout.strip() != "true":
        raise SyncError("mirror_not_repository", "fixed mirror is not a Git work tree")
    reported = git(
        "rev-parse", "--path-format=absolute", "--git-dir", cwd=MIRROR
    ).stdout.strip()
    try:
        reported_git_dir = Path(reported).resolve(strict=True)
    except OSError as exc:
        raise SyncError("mirror_gitdir_invalid", "mirror git directory is invalid") from exc
    if reported_git_dir != git_real:
        raise SyncError("mirror_gitdir_escape", "Git selected a directory outside the mirror")
    if git(
        "status", "--porcelain=v1", "--untracked-files=all", cwd=MIRROR
    ).stdout:
        raise SyncError("mirror_dirty", "mirror work tree must be completely clean")
    commit = git("rev-parse", "--verify", "HEAD^{commit}", cwd=MIRROR).stdout.strip()
    if not COMMIT_RE.fullmatch(commit):
        raise SyncError("mirror_head_invalid", "mirror HEAD is not a full commit")
    branch_result = git(
        "symbolic-ref", "--quiet", "--short", "HEAD", cwd=MIRROR, check=False
    )
    branch = branch_result.stdout.strip() if branch_result.returncode == 0 else ""
    if branch != "master":
        raise SyncError(
            "mirror_not_attached_master",
            "mirror HEAD must be attached to the master branch",
        )

    mirror_after, mirror_after_metadata = _owned_directory(MIRROR, code="mirror_changed")
    git_after, git_after_metadata = _owned_directory(git_path, code="mirror_changed")
    config_after_metadata = _owned_regular_file(
        git_path / "config",
        parent=git_after,
        code="mirror_changed",
    )
    before_identities = (
        (mirror_metadata.st_dev, mirror_metadata.st_ino),
        (git_metadata.st_dev, git_metadata.st_ino),
        (config_metadata.st_dev, config_metadata.st_ino),
    )
    after_identities = (
        (mirror_after_metadata.st_dev, mirror_after_metadata.st_ino),
        (git_after_metadata.st_dev, git_after_metadata.st_ino),
        (config_after_metadata.st_dev, config_after_metadata.st_ino),
    )
    if mirror_after != mirror_real or git_after != git_real or after_identities != before_identities:
        raise SyncError("mirror_changed", "mirror changed during validation")
    return MirrorState(
        commit=commit,
        branch=branch,
        mirror_identity=before_identities[0],
        git_identity=before_identities[1],
        config_identity=before_identities[2],
    )


@contextmanager
def exclusive_lock() -> Iterator[None]:
    flags = (
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    try:
        fd = os.open(LOCK, flags, 0o600)
        metadata = os.fstat(fd)
        if not stat.S_ISREG(metadata.st_mode):
            os.close(fd)
            raise SyncError("lock_not_regular", "lock must be a regular file")
        if (
            metadata.st_uid != os.geteuid()
            or metadata.st_gid != os.getegid()
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            os.close(fd)
            raise SyncError("lock_unsafe", "lock ownership, group, or mode is unsafe")
    except SyncError:
        raise
    except OSError as exc:
        raise SyncError("lock_unavailable", "lock file cannot be opened safely") from exc
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SyncError("already_running", "another governance sync is running") from exc
        yield
    finally:
        os.close(fd)


def ensure_receipts_dir() -> None:
    try:
        RECEIPTS.mkdir(mode=0o700, exist_ok=True)
        metadata = RECEIPTS.lstat()
        resolved = RECEIPTS.resolve(strict=True)
        resolved_metadata = resolved.lstat()
        if (
            stat.S_ISLNK(metadata.st_mode)
            or not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_gid != os.getegid()
            or stat.S_IMODE(metadata.st_mode) != 0o700
            or not stat.S_ISDIR(resolved_metadata.st_mode)
            or (metadata.st_dev, metadata.st_ino)
            != (resolved_metadata.st_dev, resolved_metadata.st_ino)
        ):
            raise OSError("unsafe receipts directory")
    except OSError as exc:
        raise SyncError("receipts_unavailable", "receipts directory is unsafe") from exc


def list_operation_refs() -> list[str]:
    result = git(
        "for-each-ref",
        "--format=%(refname)",
        f"{OPERATION_NAMESPACE}/",
        cwd=MIRROR,
    )
    refs = [line for line in result.stdout.splitlines() if line]
    if any(not ref.startswith(f"{OPERATION_NAMESPACE}/") for ref in refs):
        raise SyncError("operation_ref_invalid", "operation ref escaped its namespace")
    return refs


def delete_operation_ref(ref: str) -> None:
    if not ref.startswith(f"{OPERATION_NAMESPACE}/"):
        raise SyncError("operation_ref_invalid", "operation ref escaped its namespace")
    result = git("update-ref", "-d", ref, cwd=MIRROR, check=False)
    if result.returncode != 0:
        raise SyncError("operation_ref_cleanup_failed", "operation ref could not be deleted")


def cleanup_stale_operation_refs() -> None:
    for ref in list_operation_refs():
        delete_operation_ref(ref)
    if list_operation_refs():
        raise SyncError("operation_ref_cleanup_failed", "operation refs remain after cleanup")


@contextmanager
def fetched_remote(operation_ref: str) -> Iterator[tuple[Path, str]]:
    """Fetch HTTPS in an isolated bare repo, then file-import into the mirror."""
    with tempfile.TemporaryDirectory(prefix="governance-sync-public-") as tmp:
        bare = Path(tmp)
        git("init", "--bare", cwd=bare)
        canonical_ref = f"{FETCH_NAMESPACE}/canonical-master"
        result = git(
            "-c",
            f"protocol.{PUBLIC_PROTOCOL}.allow=always",
            "fetch",
            "--quiet",
            "--no-tags",
            "--no-write-fetch-head",
            PUBLIC_REMOTE,
            f"+{MASTER_REF}:{canonical_ref}",
            cwd=bare,
            check=False,
        )
        if result.returncode != 0:
            raise SyncError("remote_fetch_failed", "fixed public remote could not be fetched")
        kind = git("cat-file", "-t", canonical_ref, cwd=bare, check=False)
        if kind.returncode != 0 or kind.stdout.strip() != "commit":
            raise SyncError("remote_master_not_commit", "fixed remote master is not a commit")
        remote_master = git(
            "rev-parse", "--verify", f"{canonical_ref}^{{commit}}", cwd=bare
        ).stdout.strip()
        if not COMMIT_RE.fullmatch(remote_master):
            raise SyncError("remote_master_invalid", "fixed remote master is invalid")
        yield bare, remote_master

        imported = git(
            "-c",
            "protocol.file.allow=always",
            "-c",
            f"url.{bare}.insteadOf={bare}",
            "fetch",
            "--quiet",
            "--no-tags",
            "--no-write-fetch-head",
            str(bare),
            f"+{canonical_ref}:{operation_ref}",
            cwd=MIRROR,
            check=False,
        )
        if imported.returncode != 0:
            raise SyncError("object_import_failed", "validated objects could not be imported")


def validate_remote_target(target: str, remote_master: str, bare: Path) -> None:
    kind = git("cat-file", "-t", target, cwd=bare, check=False)
    if kind.returncode != 0 or kind.stdout.strip() != "commit":
        mirror_kind = git("cat-file", "-t", target, cwd=MIRROR, check=False)
        if mirror_kind.returncode == 0 and mirror_kind.stdout.strip() == "commit":
            raise SyncError(
                "target_not_canonical",
                "requested commit is not on remote master",
            )
        raise SyncError("target_not_commit", "requested object is not a commit")
    canonical = git(
        "merge-base",
        "--is-ancestor",
        target,
        remote_master,
        cwd=bare,
        check=False,
    )
    if canonical.returncode != 0:
        raise SyncError("target_not_canonical", "requested commit is not on remote master")


def validate_mirror_fast_forward(target: str, state: MirrorState) -> None:
    fast_forward = git(
        "merge-base",
        "--is-ancestor",
        state.commit,
        target,
        cwd=MIRROR,
        check=False,
    )
    if fast_forward.returncode != 0:
        raise SyncError("non_fast_forward", "requested commit is not a fast-forward")


def create_backup_ref(state: MirrorState, operation_id: str) -> str:
    backup_ref = f"{BACKUP_NAMESPACE}/{operation_id}"
    try:
        git(
            "update-ref",
            backup_ref,
            state.commit,
            ZERO_OID,
            cwd=MIRROR,
            check=False,
        )
    except Exception:
        pass
    observed = inspect_ref(
        backup_ref,
        uncertain_code="backup_ref_state_uncertain",
    )
    if observed == state.commit:
        return backup_ref
    if observed is None:
        raise SyncError("backup_ref_failed", "backup ref could not be created")
    raise SyncError(
        "backup_ref_state_uncertain",
        "backup ref has an unexpected value",
    )


def advance_master(state: MirrorState, target: str) -> None:
    try:
        git(
            "update-ref",
            MASTER_REF,
            target,
            state.commit,
            cwd=MIRROR,
            check=False,
        )
    except Exception:
        pass
    observed = inspect_ref(
        MASTER_REF,
        uncertain_code="master_ref_state_uncertain",
    )
    if observed == target:
        return
    if observed == state.commit:
        raise SyncError("master_cas_failed", "master changed before it could be advanced")
    raise SyncError(
        "master_ref_state_uncertain",
        "master has an unexpected value",
    )


def inspect_ref(ref: str, *, uncertain_code: str) -> str | None:
    """Return a real ref value, absent, or a dedicated uncertain-state error."""
    try:
        result = git("show-ref", "--verify", "--hash", ref, cwd=MIRROR, check=False)
    except Exception as exc:
        raise SyncError(uncertain_code, "ref state could not be inspected") from exc
    if result.returncode == 1 and not result.stdout:
        return None
    value = result.stdout.strip()
    if result.returncode != 0 or not COMMIT_RE.fullmatch(value):
        raise SyncError(uncertain_code, "ref state could not be proven")
    return value


def reset_and_verify(expected: str) -> None:
    git("reset", "--quiet", "--hard", expected, cwd=MIRROR)
    current = validate_mirror()
    if current.commit != expected:
        raise SyncError("postcondition_failed", "mirror HEAD does not match requested commit")


def rollback_master(state: MirrorState, failed_target: str) -> None:
    result = git(
        "update-ref",
        MASTER_REF,
        state.commit,
        failed_target,
        cwd=MIRROR,
        check=False,
    )
    if result.returncode != 0:
        raise SyncError("rollback_cas_failed", "master changed before rollback")
    try:
        git("reset", "--quiet", "--hard", state.commit, cwd=MIRROR)
        restored = validate_mirror()
    except Exception as exc:
        raise SyncError(
            "rollback_worktree_failed",
            "master was restored but its work tree could not be reset",
        ) from exc
    if restored.commit != state.commit:
        raise SyncError("rollback_verification_failed", "rollback did not restore previous HEAD")


def write_receipt(
    *,
    operation_id: str,
    started_at: str,
    finished_at: str,
    before: str,
    after: str,
    remote_master: str,
    target: str,
    backup_ref: str,
) -> Path:
    """Atomically write an allowlist-only receipt."""
    ensure_receipts_dir()
    receipt = {
        "schema_version": RECEIPT_VERSION,
        "source_mode": "public-fixed-remote",
        "remote_url_id": REMOTE_URL_ID,
        "remote_master": remote_master,
        "target_commit": target,
        "before_commit": before,
        "after_commit": after,
        "backup_ref": backup_ref,
        "operation_id": operation_id,
        "started_at": started_at,
        "finished_at": finished_at,
        "status": "applied",
    }
    destination = RECEIPTS / f"{operation_id}.receipt.json"
    temporary = RECEIPTS / f".{operation_id}.receipt.tmp"
    flags = (
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    published = False
    try:
        if destination.exists() or destination.is_symlink():
            raise OSError("receipt destination already exists")
        fd = os.open(temporary, flags, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(receipt, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
        published = True
        directory_fd = os.open(RECEIPTS, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError as exc:
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass
        if published:
            try:
                destination.unlink(missing_ok=True)
                directory_fd = os.open(RECEIPTS, os.O_RDONLY)
                try:
                    os.fsync(directory_fd)
                finally:
                    os.close(directory_fd)
            except OSError as cleanup_exc:
                raise SyncError(
                    "receipt_state_uncertain",
                    "receipt publication state could not be proven",
                ) from cleanup_exc
        raise SyncError("receipt_write_failed", "receipt could not be committed") from exc
    return destination


def synchronize(request: Request) -> dict[str, object]:
    started_at = utc_now()
    operation_id = f"{dt.datetime.now(dt.timezone.utc):%Y%m%dT%H%M%SZ}-{uuid.uuid4().hex}"
    operation_ref = f"{OPERATION_NAMESPACE}/{operation_id}"

    with exclusive_lock():
        state = validate_mirror()
        cleanup_stale_operation_refs()
        try:
            with fetched_remote(operation_ref) as (bare, remote_master):
                validate_remote_target(request.commit, remote_master, bare)
            validate_mirror_fast_forward(request.commit, state)
            if request.dry_run:
                delete_operation_ref(operation_ref)
                return {
                    "status": "dry-run",
                    "before_commit": state.commit,
                    "commit": request.commit,
                    "remote_master": remote_master,
                    "would_change": state.commit != request.commit,
                }
            if state.commit == request.commit:
                delete_operation_ref(operation_ref)
                return {
                    "status": "no-op",
                    "commit": state.commit,
                    "before_commit": state.commit,
                    "remote_master": remote_master,
                    "backup_ref": None,
                }

            backup_ref = create_backup_ref(state, operation_id)
            master_moved = False
            try:
                advance_master(state, request.commit)
                master_moved = True
                reset_and_verify(request.commit)
                after = validate_mirror().commit
                delete_operation_ref(operation_ref)
                receipt = write_receipt(
                    operation_id=operation_id,
                    started_at=started_at,
                    finished_at=utc_now(),
                    before=state.commit,
                    after=after,
                    remote_master=remote_master,
                    target=request.commit,
                    backup_ref=backup_ref,
                )
            except Exception as exc:
                if not master_moved:
                    if isinstance(exc, SyncError):
                        raise
                    raise SyncError("update_failed", "master update failed") from exc
                if isinstance(exc, SyncError) and exc.code == "receipt_state_uncertain":
                    raise
                try:
                    rollback_master(state, request.commit)
                except SyncError as rollback:
                    raise SyncError(
                        "rollback_failed",
                        "transaction failed and master/work tree were not restored",
                    ) from rollback
                if isinstance(exc, SyncError):
                    raise
                raise SyncError("update_failed", "update failed and was rolled back") from exc
            return {
                "status": "applied",
                "commit": after,
                "remote_master": remote_master,
                "receipt": receipt.name,
                "backup_ref": backup_ref,
            }
        except BaseException as primary:
            try:
                delete_operation_ref(operation_ref)
            except SyncError as cleanup:
                if (
                    isinstance(primary, SyncError)
                    and primary.code == "receipt_state_uncertain"
                ):
                    raise primary
                raise cleanup from primary
            raise


def main(argv: Sequence[str] | None = None) -> int:
    try:
        request = parse_args(argv)
        establish_process_security()
        result = synchronize(request)
    except SyncError as exc:
        print(json.dumps({"status": "error", "error_code": exc.code}), file=sys.stderr)
        return 1
    except Exception:
        print(
            json.dumps({"status": "error", "error_code": "internal_error"}),
            file=sys.stderr,
        )
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
