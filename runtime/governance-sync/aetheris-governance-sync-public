#!/usr/bin/python3 -I
"""Install a governance bundle from one fixed anonymous GitHub Release."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Sequence

INCOMING = Path("/var/lib/aetheris-governance-sync/incoming")
BUNDLE = INCOMING / "governance.bundle"
STAGING_NAME = ".public-release"
HELPER = "/usr/local/sbin/aetheris-governance-sync"

RELEASE_API_BASE = (
    "https://api.github.com/repos/lyosvne/"
    "agent-collaboration-standard"
)
RELEASE_TAG_PREFIX = "governance-sync-"
MANIFEST_NAME = "governance-sync-manifest.json"
BUNDLE_NAME = "governance.bundle"

COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
ERROR_CODE_RE = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
RECEIPT_RE = re.compile(r"^[A-Za-z0-9._-]{1,255}\.receipt\.json$")
BACKUP_REF_RE = re.compile(
    r"^refs/aetheris-governance-sync/backups/[A-Za-z0-9._-]{1,255}$"
)
SOURCE_CLEANUP_VALUES = {"clean", "pending", "state-unknown"}
MAX_METADATA_BYTES = 1024 * 1024
MAX_MANIFEST_BYTES = 16 * 1024
MAX_BUNDLE_BYTES = 64 * 1024 * 1024
MAX_HELPER_OUTPUT_BYTES = 16 * 1024
CURL_CONNECT_TIMEOUT_SECONDS = 10
CURL_TIMEOUT_SECONDS = 180
MANIFEST_SCHEMA_VERSION = 1


class SyncError(RuntimeError):
    """Expected sanitized failure."""

    def __init__(self, code: str):
        super().__init__(code)
        self.code = code


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise SyncError("invalid_arguments")


@dataclass(frozen=True)
class Request:
    commit: str
    dry_run: bool


@dataclass(frozen=True)
class Asset:
    name: str
    asset_id: int
    size: int


@dataclass(frozen=True)
class Manifest:
    commit: str
    bundle_size: int
    bundle_sha256: str


def parse_args(argv: Sequence[str] | None = None) -> Request:
    parser = JsonArgumentParser(
        prog="aetheris-governance-sync-public",
        allow_abbrev=False,
        add_help=False,
    )
    parser.add_argument("--commit", required=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    ns = parser.parse_args(argv)
    if not COMMIT_RE.fullmatch(ns.commit):
        parser.error("invalid commit")
    return Request(ns.commit, ns.dry_run)


def establish_process_security() -> None:
    os.umask(0o027)
    if os.geteuid() == 0:
        raise SyncError("root_execution_forbidden")


def _curl_environment() -> dict[str, str]:
    return {
        "PATH": "/usr/bin:/bin",
        "HOME": "/nonexistent",
        "CURL_HOME": "/nonexistent",
        "XDG_CONFIG_HOME": "/nonexistent",
        "LANG": "C",
        "LC_ALL": "C",
    }


def download(url: str, destination: Path, maximum: int, *, asset: bool) -> None:
    if not url.startswith(f"{RELEASE_API_BASE}/"):
        raise SyncError("download_url_invalid")
    argv = [
        "/usr/bin/curl",
        "--disable",
        "--config",
        "/dev/null",
        "--fail",
        "--silent",
        "--show-error",
        "--location",
        "--max-redirs",
        "3",
        "--proto",
        "=https",
        "--proto-redir",
        "=https",
        "--tlsv1.2",
        "--connect-timeout",
        str(CURL_CONNECT_TIMEOUT_SECONDS),
        "--max-time",
        str(CURL_TIMEOUT_SECONDS),
        "--max-filesize",
        str(maximum),
        "--proxy",
        "",
        "--header",
        "Accept: application/octet-stream" if asset else "Accept: application/vnd.github+json",
        "--header",
        "X-GitHub-Api-Version: 2022-11-28",
        "--user-agent",
        "aetheris-governance-sync-public/1",
        "--output",
        str(destination),
        url,
    ]
    try:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=False,
            shell=False,
            check=False,
            timeout=CURL_TIMEOUT_SECONDS + 5,
            env=_curl_environment(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SyncError("download_failed") from exc
    if result.returncode != 0:
        raise SyncError("download_failed")
    try:
        metadata = destination.lstat()
    except OSError as exc:
        raise SyncError("download_failed") from exc
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > maximum:
        raise SyncError("download_size_invalid")


def _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def read_json(path: Path, maximum: int, error_code: str) -> object:
    try:
        raw = path.read_bytes()
        if not raw or len(raw) > maximum:
            raise ValueError("invalid size")
        return json.loads(raw, object_pairs_hook=_unique_object)
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
        raise SyncError(error_code) from exc


def parse_release_metadata(payload: object, commit: str) -> dict[str, Asset]:
    tag = f"{RELEASE_TAG_PREFIX}{commit}"
    if not isinstance(payload, dict):
        raise SyncError("release_metadata_invalid")
    if (
        payload.get("tag_name") != tag
        or payload.get("target_commitish") != commit
        or payload.get("draft") is not False
        or payload.get("prerelease") is not False
        or payload.get("immutable") is not True
    ):
        raise SyncError("release_identity_mismatch")
    raw_assets = payload.get("assets")
    if not isinstance(raw_assets, list):
        raise SyncError("release_metadata_invalid")
    selected: dict[str, Asset] = {}
    for raw in raw_assets:
        if not isinstance(raw, dict):
            raise SyncError("release_metadata_invalid")
        name = raw.get("name")
        asset_id = raw.get("id")
        size = raw.get("size")
        if name not in {MANIFEST_NAME, BUNDLE_NAME}:
            continue
        if (
            name in selected
            or isinstance(asset_id, bool)
            or not isinstance(asset_id, int)
            or asset_id <= 0
            or isinstance(size, bool)
            or not isinstance(size, int)
            or size <= 0
        ):
            raise SyncError("release_metadata_invalid")
        limit = MAX_MANIFEST_BYTES if name == MANIFEST_NAME else MAX_BUNDLE_BYTES
        if size > limit:
            raise SyncError("release_asset_size_invalid")
        selected[name] = Asset(name, asset_id, size)
    if set(selected) != {MANIFEST_NAME, BUNDLE_NAME}:
        raise SyncError("release_assets_missing")
    return selected


def asset_api_url(asset: Asset) -> str:
    return f"{RELEASE_API_BASE}/releases/assets/{asset.asset_id}"


def parse_manifest(payload: object, commit: str) -> Manifest:
    if not isinstance(payload, dict) or set(payload) != {
        "schema_version",
        "commit",
        "bundle",
    }:
        raise SyncError("manifest_schema_invalid")
    bundle = payload.get("bundle")
    if (
        payload.get("schema_version") != MANIFEST_SCHEMA_VERSION
        or payload.get("commit") != commit
        or not isinstance(bundle, dict)
        or set(bundle) != {"name", "size", "sha256"}
        or bundle.get("name") != BUNDLE_NAME
    ):
        raise SyncError("manifest_schema_invalid")
    size = bundle.get("size")
    digest = bundle.get("sha256")
    if (
        isinstance(size, bool)
        or not isinstance(size, int)
        or size <= 0
        or size > MAX_BUNDLE_BYTES
        or not isinstance(digest, str)
        or SHA256_RE.fullmatch(digest) is None
    ):
        raise SyncError("manifest_schema_invalid")
    return Manifest(commit, size, digest)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as stream:
            while block := stream.read(1024 * 1024):
                digest.update(block)
    except OSError as exc:
        raise SyncError("bundle_read_failed") from exc
    return digest.hexdigest()


def validate_downloaded_asset(path: Path, expected_size: int, expected_sha: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise SyncError("bundle_read_failed") from exc
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size != expected_size:
        raise SyncError("bundle_size_mismatch")
    if sha256_file(path) != expected_sha:
        raise SyncError("bundle_sha256_mismatch")


def _open_incoming() -> int:
    flags = (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    try:
        fd = os.open(INCOMING, flags)
        metadata = os.fstat(fd)
    except OSError as exc:
        raise SyncError("incoming_unavailable") from exc
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        os.close(fd)
        raise SyncError("incoming_unsafe")
    return fd


def _validate_fixed_bundle(directory_fd: int, *, missing_ok: bool) -> os.stat_result | None:
    try:
        metadata = os.stat(BUNDLE_NAME, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        if missing_ok:
            return None
        raise SyncError("bundle_unsafe")
    except OSError as exc:
        raise SyncError("bundle_unsafe") from exc
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise SyncError("bundle_unsafe")
    return metadata


def publish_bundle(source: Path) -> tuple[int, tuple[int, int]]:
    directory_fd = _open_incoming()
    flags = (
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    staging_fd: int | None = None
    staging_identity: tuple[int, int] | None = None
    identity: tuple[int, int] | None = None
    renamed = False
    try:
        if _validate_fixed_bundle(directory_fd, missing_ok=True) is not None:
            raise SyncError("incoming_busy")
        try:
            staging_fd = os.open(STAGING_NAME, flags, 0o600, dir_fd=directory_fd)
        except FileExistsError as exc:
            raise SyncError("incoming_busy") from exc
        staging_metadata = os.fstat(staging_fd)
        staging_identity = (staging_metadata.st_dev, staging_metadata.st_ino)
        os.fchown(staging_fd, os.geteuid(), os.getegid())
        os.fchmod(staging_fd, 0o600)
        with source.open("rb") as stream:
            while block := stream.read(1024 * 1024):
                view = memoryview(block)
                while view:
                    written = os.write(staging_fd, view)
                    if written <= 0:
                        raise OSError("short write")
                    view = view[written:]
        os.fsync(staging_fd)
        metadata = os.fstat(staging_fd)
        identity = (metadata.st_dev, metadata.st_ino)
        named = os.stat(STAGING_NAME, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(named.st_mode)
            or (named.st_dev, named.st_ino) != identity
            or named.st_uid != os.geteuid()
            or named.st_gid != os.getegid()
            or stat.S_IMODE(named.st_mode) != 0o600
        ):
            raise SyncError("bundle_publish_unsafe")
        os.close(staging_fd)
        staging_fd = None
        os.replace(
            STAGING_NAME,
            BUNDLE_NAME,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        renamed = True
        os.fsync(directory_fd)
        published = _validate_fixed_bundle(directory_fd, missing_ok=False)
        if (published.st_dev, published.st_ino) != identity:
            raise SyncError("bundle_publish_unsafe")
        return directory_fd, identity
    except BaseException as exc:
        if staging_fd is not None:
            try:
                os.close(staging_fd)
            except OSError:
                pass
            staging_fd = None
        if staging_identity is not None:
            try:
                owned_names: list[str] = []
                for name in (STAGING_NAME, BUNDLE_NAME):
                    try:
                        current = os.stat(
                            name, dir_fd=directory_fd, follow_symlinks=False
                        )
                    except FileNotFoundError:
                        continue
                    if (
                        not stat.S_ISREG(current.st_mode)
                        or (current.st_dev, current.st_ino) != staging_identity
                    ):
                        if name == STAGING_NAME or renamed:
                            raise OSError("published inode changed")
                        continue
                    owned_names.append(name)
                if not owned_names:
                    raise OSError("created inode location unknown")
                for name in owned_names:
                    os.unlink(name, dir_fd=directory_fd)
                os.fsync(directory_fd)
            except OSError as cleanup_exc:
                os.close(directory_fd)
                raise SyncError("bundle_publish_state_unknown") from cleanup_exc
        os.close(directory_fd)
        if isinstance(exc, SyncError):
            raise
        if isinstance(exc, (SystemExit, KeyboardInterrupt)):
            raise
        raise SyncError("bundle_publish_failed") from exc
    finally:
        if staging_fd is not None:
            try:
                os.close(staging_fd)
            except OSError:
                pass


def cleanup_published_bundle(
    directory_fd: int, identity: tuple[int, int]
) -> str:
    try:
        try:
            current = os.stat(
                BUNDLE_NAME, dir_fd=directory_fd, follow_symlinks=False
            )
        except OSError:
            return "state-unknown"
        if (
            not stat.S_ISREG(current.st_mode)
            or (current.st_dev, current.st_ino) != identity
        ):
            return "state-unknown"
        try:
            os.unlink(BUNDLE_NAME, dir_fd=directory_fd)
        except OSError:
            try:
                remaining = os.stat(
                    BUNDLE_NAME, dir_fd=directory_fd, follow_symlinks=False
                )
            except OSError:
                return "state-unknown"
            if (
                stat.S_ISREG(remaining.st_mode)
                and (remaining.st_dev, remaining.st_ino) == identity
            ):
                return "pending"
            return "state-unknown"
        try:
            os.fsync(directory_fd)
        except OSError:
            return "state-unknown"
        return "clean"
    except Exception:
        return "state-unknown"
    finally:
        try:
            os.close(directory_fd)
        except OSError:
            pass


def _cleanup_outcome(directory_fd: int, identity: tuple[int, int]) -> str:
    try:
        outcome = cleanup_published_bundle(directory_fd, identity)
    except Exception:
        return "state-unknown"
    return outcome if outcome in SOURCE_CLEANUP_VALUES else "state-unknown"


def _single_json(raw: str) -> dict[str, object] | None:
    if not raw or len(raw.encode("utf-8")) > MAX_HELPER_OUTPUT_BYTES:
        return None
    try:
        payload = json.loads(raw, object_pairs_hook=_unique_object)
    except (UnicodeError, ValueError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def _valid_commit(value: object) -> bool:
    return isinstance(value, str) and COMMIT_RE.fullmatch(value) is not None


def validate_helper_response(
    request: Request,
    digest: str,
    returncode: int,
    stdout: str,
    stderr: str,
) -> dict[str, object]:
    if returncode != 0:
        payload = _single_json(stderr) if not stdout else None
        if (
            payload is None
            or set(payload) != {"status", "error_code"}
            or payload.get("status") != "error"
            or not isinstance(payload.get("error_code"), str)
            or ERROR_CODE_RE.fullmatch(payload["error_code"]) is None
        ):
            raise SyncError("bundle_helper_failed")
        return payload
    payload = _single_json(stdout) if not stderr else None
    if payload is None:
        raise SyncError("bundle_helper_invalid_response")
    status = payload.get("status")
    if request.dry_run:
        if (
            set(payload) != {"status", "commit", "sha256", "before_commit", "would_change"}
            or status != "dry-run"
            or payload.get("commit") != request.commit
            or payload.get("sha256") != digest
            or not _valid_commit(payload.get("before_commit"))
            or not isinstance(payload.get("would_change"), bool)
        ):
            raise SyncError("bundle_helper_invalid_response")
        return payload
    if status == "no-op":
        if (
            set(payload) != {"status", "commit", "before_commit", "backup_ref"}
            or payload.get("commit") != request.commit
            or payload.get("before_commit") != request.commit
            or payload.get("backup_ref") is not None
        ):
            raise SyncError("bundle_helper_invalid_response")
        return payload
    if status == "applied":
        if (
            set(payload) != {"status", "commit", "receipt", "backup_ref"}
            or payload.get("commit") != request.commit
            or not isinstance(payload.get("receipt"), str)
            or RECEIPT_RE.fullmatch(payload["receipt"]) is None
            or not isinstance(payload.get("backup_ref"), str)
            or BACKUP_REF_RE.fullmatch(payload["backup_ref"]) is None
        ):
            raise SyncError("bundle_helper_invalid_response")
        return payload
    raise SyncError("bundle_helper_invalid_response")


def run_bundle_helper(request: Request, digest: str) -> tuple[int, dict[str, object]]:
    argv = [
        HELPER,
        "--bundle",
        str(BUNDLE),
        "--commit",
        request.commit,
        "--sha256",
        digest,
    ]
    if request.dry_run:
        argv.append("--dry-run")
    try:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            shell=False,
            check=False,
            env={"PATH": "/usr/bin:/bin", "HOME": "/nonexistent", "LANG": "C", "LC_ALL": "C"},
        )
    except OSError as exc:
        raise SyncError("bundle_helper_execution_failed") from exc
    return result.returncode, validate_helper_response(
        request, digest, result.returncode, result.stdout, result.stderr
    )


def synchronize(request: Request) -> tuple[int, dict[str, object]]:
    tag = f"{RELEASE_TAG_PREFIX}{request.commit}"
    release_url = f"{RELEASE_API_BASE}/releases/tags/{tag}"
    with tempfile.TemporaryDirectory(prefix="governance-sync-release-") as temporary:
        root = Path(temporary)
        metadata_path = root / "release.json"
        manifest_path = root / MANIFEST_NAME
        bundle_path = root / BUNDLE_NAME
        download(release_url, metadata_path, MAX_METADATA_BYTES, asset=False)
        assets = parse_release_metadata(
            read_json(metadata_path, MAX_METADATA_BYTES, "release_metadata_invalid"),
            request.commit,
        )
        download(
            asset_api_url(assets[MANIFEST_NAME]),
            manifest_path,
            MAX_MANIFEST_BYTES,
            asset=True,
        )
        if manifest_path.stat().st_size != assets[MANIFEST_NAME].size:
            raise SyncError("manifest_size_mismatch")
        manifest = parse_manifest(
            read_json(manifest_path, MAX_MANIFEST_BYTES, "manifest_schema_invalid"),
            request.commit,
        )
        if manifest.bundle_size != assets[BUNDLE_NAME].size:
            raise SyncError("bundle_size_mismatch")
        download(
            asset_api_url(assets[BUNDLE_NAME]),
            bundle_path,
            MAX_BUNDLE_BYTES,
            asset=True,
        )
        validate_downloaded_asset(
            bundle_path, manifest.bundle_size, manifest.bundle_sha256
        )
        directory_fd, identity = publish_bundle(bundle_path)
        try:
            returncode, payload = run_bundle_helper(request, manifest.bundle_sha256)
        except BaseException as exc:
            cleanup = _cleanup_outcome(directory_fd, identity)
            if cleanup != "clean":
                raise SyncError(
                    "bundle_cleanup_pending"
                    if cleanup == "pending"
                    else "bundle_cleanup_state_unknown"
                ) from exc
            raise
        cleanup = _cleanup_outcome(directory_fd, identity)
        if returncode == 0:
            result = dict(payload)
            result["source_cleanup"] = cleanup
            return 0, result
        if cleanup == "clean":
            return returncode, payload
        return 1, {
            "status": "error",
            "error_code": (
                "bundle_cleanup_pending"
                if cleanup == "pending"
                else "bundle_cleanup_state_unknown"
            ),
        }


def main(argv: Sequence[str] | None = None) -> int:
    try:
        request = parse_args(argv)
        establish_process_security()
        returncode, payload = synchronize(request)
    except SyncError as exc:
        print(
            json.dumps({"status": "error", "error_code": exc.code}, separators=(",", ":")),
            file=sys.stderr,
        )
        return 1
    except Exception:
        print(
            json.dumps({"status": "error", "error_code": "internal_error"}, separators=(",", ":")),
            file=sys.stderr,
        )
        return 1
    print(
        json.dumps(payload, sort_keys=True, separators=(",", ":")),
        file=sys.stderr if returncode else sys.stdout,
    )
    return returncode


if __name__ == "__main__":
    raise SystemExit(main())
