{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Work Ledger Event",
  "type": "object",
  "required": ["event", "task_id", "owner", "tool", "base_commit", "timestamp"],
  "properties": {
    "event": { "type": "string", "enum": ["start", "claim", "update", "blocked", "handoff", "review", "finish", "archive"] },
    "task_id": { "type": "string" },
    "owner": { "type": "string" },
    "tool": { "type": "string" },
    "mode": { "type": "string", "enum": ["serial", "parallel"] },
    "branch": { "type": "string" },
    "base_commit": { "type": "string" },
    "lock_scope": { "type": "string" },
    "files_intended": { "type": "array", "items": { "type": "string" } },
    "files_touched": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "risk": { "type": "string" },
    "next_action": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
